{
  "name": "web-content-extractor",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "buildFrontend": "cd WebUI && bun run buildDist",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test ./tests/unit",
    "test:api": "bun test ./tests/integration",
    "test": "bun test ./tests/",
    "generate:openapi": "bun run scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@kreuzberg/html-to-markdown": "^3.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "mozilla/readability#main",
    "hono": "^4.13.1",
    "hono-openapi": "^1.3.1",
    "html-to-text": "^10.0.0",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/html-to-text": "^9.0.4",
    "@types/turndown": "^5.0.6",
    "typescript": "~6.0.2"
  }
}
