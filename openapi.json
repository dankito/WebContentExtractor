                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "html": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string"
                  },
                  "includeMetadata": {
                    "type": "boolean"
                  },
                  "preserveLinkUrlsInPlainText": {
                    "type": "boolean"
                  },
                  "preserveImageUrlsInPlainText": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
